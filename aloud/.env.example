# Copy to aloud/.env. Vertex AI with your gcloud application-default credentials.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Optional: Model Armor template for prompt-injection screening. Without it, local patterns run.
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_LOCATION=us-central1
# 1 writes a receipt per Guardian decision to Firestore; 0 writes receipts.jsonl.
ALOUD_FIRESTORE=0
# ALOUD_MODEL=gemini-3.6-flash
